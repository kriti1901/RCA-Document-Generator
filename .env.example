# ---- LLM (any OpenAI-compatible endpoint) -------------------------------
# Groq free tier (default). Create a free key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-120b
# Per-agent overrides (each falls back to LLM_MODEL). On Groq's free tier every model
# has its own per-minute token budget, so spreading the agents means fewer waits.
LLM_MODEL_DRAFTER=qwen/qwen3.8-27b
LLM_MODEL_CLARIFIER=qwen/qwen3.8-27b
LLM_MODEL_EXTRACTOR_LISTS=openai/gpt-oss-20b
# LLM_MODEL_EXTRACTOR=
# LLM_MODEL_PLANNER=
# LLM_MODEL_REVIEWER=
# See which models your key can call:  python scripts/bakeoff.py --list

# Local model with Ollama instead (no key needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.6:27b
# LLM_MAX_TOKENS_PARAM=max_tokens

# Offline demo with a rule-based stand-in instead of a model (no key):
# LLM_BACKEND=demo

# ---- Confluence Cloud (leave empty to save PDFs locally only) -----------
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=OPS
CONFLUENCE_PARENT_PATH=Knowledge Base/RCAs
# CONFLUENCE_CREATE_MISSING_PARENTS=false

# ---- Storage -------------------------------------------------------------
# RCA_DATA_DIR=./data
